# 复制为同目录的 secrets.toml 后只在本机使用。secrets.toml 已在 .gitignore 中，不要提交。
# Streamlit Community Cloud：App settings → Secrets，粘贴同样内容。
# 公网演示必须保持 MOCK = "1"。不要写入 KUBECONFIG、kubeconfig 正文或集群证书。

MOCK = "1"

# 可选。需要模型时再取消下面三行的注释，并换成你自己的值。
# 不要写成空字符串：程序会把非空 Key 当成「已配置」。
# 规则回退不需要这三项，评委演示建议保持注释。
# OPENAI_API_KEY = "替换成你的密钥"
# OPENAI_BASE_URL = "https://api.openai.com/v1"
# OPENAI_MODEL = "gpt-4o-mini"
