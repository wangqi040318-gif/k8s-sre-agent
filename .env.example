# 复制为 .env 后按需填写。无 API Key 时自动走规则/模板诊断回退。

# Mock 模式：1=使用内置假数据（默认，无需真实集群）
# 修复动作默认不执行。CLI 需 --apply --confirm YES，或在提示中输入 CONFIRM。
MOCK=1

# 可选：兼容 OpenAI 协议的 LLM（通义 / DeepSeek / OpenAI 等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 真实集群时设置（MOCK=0）
# KUBECONFIG=/path/to/kubeconfig
K8S_NAMESPACE=default

# RAG 索引目录
RAG_INDEX_DIR=.rag_index
